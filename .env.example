# ---------------------------------------------------------------------------
# PSX Trading Desk — environment
# Copy to .env and fill in the key you use. Every PSXDESK_* value is optional.
# ---------------------------------------------------------------------------

# LLM key (required to run the agents).
#   google-genai backend (default): a Gemini API key from https://aistudio.google.com
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
PSXDESK_LLM_BACKEND=google-genai        # google-genai | langchain
PSXDESK_DEEP_MODEL=gemini-3-pro         # fundamental analyst + CRO
PSXDESK_QUICK_MODEL=gemini-3-flash      # technical analyst + researchers
PSXDESK_TEMPERATURE=0.2
PSXDESK_MAX_OUTPUT_TOKENS=8192

# ---------------------------------------------------------------------------
# PSX market structure
# ---------------------------------------------------------------------------
# Scrip-level circuit band in force. The desk rulebook is 5%; PSX Regulation
# 19.3 lets the Exchange widen it (historically to 7.5%). When the exchange's
# symbol_price file exists for the session its caps always win over this value.
PSXDESK_CIRCUIT_BAND_PCT=5.0
PSXDESK_CIRCUIT_FLOOR_PKR=1.0           # "5% or Rs.1, whichever is higher"
PSXDESK_TICK_SIZE_PKR=0.01

# ---------------------------------------------------------------------------
# Scraping politeness / caching
# ---------------------------------------------------------------------------
PSXDESK_THROTTLE_SECONDS=0.75           # minimum gap between psx.com.pk requests
PSXDESK_HTTP_TIMEOUT_S=30
PSXDESK_HTTP_RETRIES=3
PSXDESK_CACHE_TTL_SECONDS=900
PSXDESK_MAX_WORKERS=6
PSXDESK_HISTORY_DAYS=400
PSXDESK_WORK_DIR=var                    # cache/, runs/ live here
# PSXDESK_OFFLINE=1                     # replay cache only, never hit the network

# ---------------------------------------------------------------------------
# Fallback macro print (only used when sbp.org.pk cannot be read)
# ---------------------------------------------------------------------------
PSXDESK_SBP_POLICY_RATE_PCT=12.00
PSXDESK_SBP_CORRIDOR_FLOOR_PCT=11.00
PSXDESK_SBP_CORRIDOR_CEILING_PCT=13.00
PSXDESK_CPI_YOY_PCT=10.3

# ---------------------------------------------------------------------------
# CRO limits
# ---------------------------------------------------------------------------
PSXDESK_NAV_PKR=50000000
PSXDESK_MAX_NAME_WEIGHT_PCT=10
PSXDESK_MAX_RISK_PER_TRADE_PCT=1
PSXDESK_MAX_ADV_PARTICIPATION_PCT=15
PSXDESK_MIN_FREE_FLOAT_MCAP_PKR=500000000
PSXDESK_MIN_ADV_VALUE_PKR=5000000
PSXDESK_MIN_PRICE_PKR=5
PSXDESK_MAX_STOP_PCT=12
PSXDESK_MIN_REWARD_RISK=1.5
PSXDESK_MAX_TARGET_HORIZON_DAYS=60

# ---------------------------------------------------------------------------
# Debate
# ---------------------------------------------------------------------------
PSXDESK_MAX_DEBATE_ROUNDS=2
